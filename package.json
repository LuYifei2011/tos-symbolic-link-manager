{
  "name": "sample-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "dev:server": "sh scripts/dev.sh",
    "build": "python3 scripts/check.py && vue-tsc --noEmit && vite build",
    "test": "npm run test:template && npm run test:server",
    "test:template": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:server": "go test -race -count=1 ./..."
  },
  "dependencies": {
    "@lucide/vue": "1.72.0",
    "tos-app-core": "https://github.com/LuYifei2011/tos-app-kit/releases/download/v0.3.1/tos-app-core-0.3.1.tgz",
    "tos-app-ui-kit": "https://github.com/LuYifei2011/tos-app-kit/releases/download/v0.3.1/tos-app-ui-kit-0.3.1.tgz",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.4"
  }
}
