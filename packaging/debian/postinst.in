#!/bin/bash
set -eu
app=/usr/local/@APP_ID@
case "${1:-}" in
configure)
    for name in data site site.next site.previous webui webui.next webui.previous; do
        if [ -L "$app/$name" ] || { [ -e "$app/$name" ] && [ ! -d "$app/$name" ]; }; then
            echo "@APP_ID@: $app/$name must be a real directory" >&2
            exit 1
        fi
    done
    # TOS creates the user, potentially after postinst. Prepare the dedicated
    # group now so Group=/SocketGroup= can resolve when TOS enables the app.
    if group_record=$(getent group @APP_ID@); then
        :
    else
        lookup_status=$?
        if [ "$lookup_status" != 2 ]; then
            echo "@APP_ID@: group lookup failed ($lookup_status)" >&2
            exit "$lookup_status"
        fi
        groupadd --system @APP_ID@
        group_record=$(getent group @APP_ID@)
    fi
    IFS=: read -r group_name group_password group_gid group_members <<< "$group_record"
    case "$group_gid" in
        ''|0|*[!0-9]*) echo "@APP_ID@: dedicated group must have a non-root GID" >&2; exit 1 ;;
    esac
    # Refresh both the backend site and the TOS platform static entry.
    for name in site webui; do
        if [ -d "$app/$name.previous" ] && [ ! -d "$app/$name" ]; then mv "$app/$name.previous" "$app/$name"; fi
        rm -rf -- "$app/$name.next" "$app/$name.previous"
        install -d -m 0755 "$app/$name.next"
        trap 'rm -rf -- "$app/$name.next"' 0
        tar -xjf "$app/webui.bz2" -C "$app/$name.next"
        test -f "$app/$name.next/index.html"
        if [ -d "$app/$name" ]; then mv "$app/$name" "$app/$name.previous"; fi
        if ! mv "$app/$name.next" "$app/$name"; then
            if [ -d "$app/$name.previous" ]; then mv "$app/$name.previous" "$app/$name"; fi
            exit 1
        fi
        rm -rf -- "$app/$name.previous"
        trap - 0
    done
    systemctl daemon-reload
    systemctl enable "$app/init.d/@APP_ID@.service" "$app/init.d/@APP_ID@.socket"
    if id @APP_ID@ >/dev/null 2>&1; then
        systemctl reset-failed @APP_ID@.service @APP_ID@.socket
        systemctl start @APP_ID@.service
    else
        echo "@APP_ID@: waiting for the TOS application account; enable the app after account creation" >&2
    fi
    ;;
esac
